# Environment
ENVIRONMENT=development

# Database (PostgreSQL 15 async)
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/cirra
DATABASE_RLS_USER=cirra_app

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ClickHouse (Cost data facts)
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=cirra

# Upstash Redis (Cache, Celery, Rate Limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_PER_MINUTE=120

# AI Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Security & Encryption (AES-256-GCM, 32 bytes base64: openssl rand -base64 32)
# NEVER set a fallback value in production or code. A missing key must throw an error.
ENCRYPTION_KEY=

# Frontend / Next.js
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cirra JWT Authentication (legacy/internal)
CIRRA_JWT_SECRET=
CIRRA_JWT_EXPIRE_MINUTES=10080

# AWS (Read-only CUR / Billing)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Vercel Cron Secret (Random string, used to secure the cron endpoint)
CRON_SECRET=

# Google Gemini (Required for Ask Cirra feature)
GEMINI_API_KEY=
