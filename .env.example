# LLM providers
GROQ_API_KEY=
GEMINI_API_KEY=
NVIDIA_NIM_API_KEY=

# ClickHouse Cloud
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=cirra

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/cirra

# Alerting & Telephony
SLACK_WEBHOOK_URL=
NTFY_TOPIC=

# Twilio Programmable Voice (Twilio + Groq Telephony)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+17372508034
PUBLIC_WEBHOOK_URL=

# GitHub
GITHUB_TOKEN=
GITHUB_REPO=owner/repo

# Internal
INTERNAL_SERVICE_KEY=internal-dev-key

# Service URLs (for local dev, leave as localhost; for production set to Render URLs)
INVESTIGATOR_URL=http://localhost:8001
SENTINEL_URL=http://localhost:8002
ACTION_ENGINE_URL=http://localhost:8003
