# Environment
ENVIRONMENT=development

# Database (PostgreSQL 15 async)
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/cirra
DATABASE_RLS_USER=cirra_app

# Redis (Cache, Celery, Rate Limiting)
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_PER_MINUTE=120

# Encryption (AES-256-GCM, 32 bytes base64: openssl rand -base64 32)
ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# Cirra JWT Authentication
CIRRA_JWT_SECRET=cirra-super-secret-jwt-key-2026-very-secure
CIRRA_JWT_EXPIRE_MINUTES=10080

# Supabase Auth Integration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Frontend / NextAuth
NEXTAUTH_SECRET=your-nextauth-secret-32-chars-long
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ClickHouse (FOCUS Ingest - future phases)
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=cirra

# AI Providers (telemetry / testing)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# AWS (Read-only CUR / Billing)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
