# ============================================================
# CIRRA — ENVIRONMENT CONFIGURATION
# Copy this to .env and fill in real values
# Never commit .env to git
# Generate ENCRYPTION_KEY with: openssl rand -base64 32
# Generate CIRRA_JWT_SECRET with: openssl rand -hex 32
# ============================================================

# ── ENVIRONMENT ─────────────────────────────────────────────
ENVIRONMENT=development
# Options: development | production

# ── POSTGRESQL (Supabase managed) ───────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:<password>@db.<supabase-project-ref>.supabase.co:5432/postgres
DATABASE_RLS_USER=cirra_app
# ^ This role must exist — created by docker/postgres/init-roles.sql
# For local dev use: postgresql+asyncpg://postgres:postgrespassword@localhost:5432/cirra

# ── REDIS (Upstash) ─────────────────────────────────────────
REDIS_URL=rediss://default:<password>@<upstash-endpoint>.upstash.io:6379
# For local dev use: redis://localhost:6379/0
RATE_LIMIT_PER_MINUTE=120

# ── ENCRYPTION ──────────────────────────────────────────────
# AES-256-GCM key — 32 bytes base64 encoded
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=

# ── CIRRA JWT ───────────────────────────────────────────────
# Generate: openssl rand -hex 32
CIRRA_JWT_SECRET=
CIRRA_JWT_EXPIRE_MINUTES=10080
# ^ 10080 = 7 days

# ── SUPABASE ────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# ^ Found in Supabase dashboard → Settings → API → JWT Secret

# ── FRONTEND (Next.js) ──────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Generate NEXTAUTH_SECRET: openssl rand -hex 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
CIRRA_DASHBOARD_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── CLICKHOUSE CLOUD ────────────────────────────────────────
CLICKHOUSE_HOST=<service-name>.<region>.aws.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=cirra
# Read-only user (created by seed_clickhouse.py)
CLICKHOUSE_READER_USER=cirra_reader
CLICKHOUSE_READER_PASSWORD=
# Ingest user (created by seed_clickhouse.py)
CLICKHOUSE_INGEST_USER=cirra_ingest
CLICKHOUSE_INGEST_PASSWORD=

# ── AI PROVIDERS ────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=gsk_...
GEMINI_API_KEY=AIza...
# GOOGLE_API_KEY is an alias for Gemini if needed
GOOGLE_API_KEY=AIza...
NVIDIA_NIM_API_KEY=nvapi-...
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# ── CLOUD PROVIDERS ─────────────────────────────────────────
# AWS (read-only billing)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# GCP (service account JSON — paste entire JSON as single line)
GCP_SERVICE_ACCOUNT_JSON=

# Vercel
VERCEL_API_TOKEN=

# Render
RENDER_API_KEY=

# ── INGEST CONFIGURATION ────────────────────────────────────
# Set INGEST_MOCK=true to use synthetic data (demo mode)
INGEST_MOCK=false
# Multiplier applied to all costs (makes free-tier look enterprise)
# Set to 1.0 for real costs, 25.0 for demo scale
COST_MULTIPLIER=25.0
# Celery broker
CELERY_BROKER_URL=rediss://default:<password>@<upstash-endpoint>.upstash.io:6379/0
CELERY_RESULT_BACKEND=rediss://default:<password>@<upstash-endpoint>.upstash.io:6379/1
# For local dev:
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── ALERT DELIVERY ──────────────────────────────────────────

# Slack (Incoming Webhook)
# Get from: api.slack.com/apps → your app → Incoming Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...
SLACK_CHANNEL=#cirra-alerts

# ntfy (push notifications — no signup needed)
# Pick any unique topic name, subscribe on ntfy.sh or the mobile app
NTFY_TOPIC_URL=https://ntfy.sh/cirra-alerts-hiten
# ntfy priority: min|low|default|high|urgent
NTFY_DEFAULT_PRIORITY=high

# Vapi (AI voice calls)
# Get from: app.vapi.ai → API Keys (key icon in left sidebar)
VAPI_API_KEY=
# Get from: app.vapi.ai → your assistant → copy ID from top bar
VAPI_ASSISTANT_ID=
# The phone number to call when anomaly fires (your number)
VAPI_ALERT_PHONE_NUMBER=+91...

# ── GITHUB (PR creation) ────────────────────────────────────
# Create a GitHub App at: github.com/settings/apps/new
# Install it on cirra-demo-infra repo
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app.pem
# Or paste the private key inline (replace newlines with \n)
GITHUB_APP_PRIVATE_KEY=
GITHUB_INSTALLATION_ID=
# The demo repo where PRs get raised
GITHUB_DEMO_REPO_OWNER=j25aiml192-hash
GITHUB_DEMO_REPO_NAME=cirra-demo-infra

# ── INVESTIGATOR SERVICE ────────────────────────────────────
# URL where services/investigator runs
INVESTIGATOR_URL=http://localhost:8001
# For docker: http://investigator:8001

# ── SENTINEL SERVICE ────────────────────────────────────────
# Anomaly detection thresholds
SENTINEL_AI_CHECK_INTERVAL_MINUTES=5
SENTINEL_CLOUD_CHECK_INTERVAL_MINUTES=60
SENTINEL_LEAKED_KEY_CHECK_INTERVAL_MINUTES=15
SENTINEL_MIN_DOLLAR_IMPACT_AI=10.0
SENTINEL_MIN_DOLLAR_IMPACT_CLOUD=50.0
SENTINEL_ZSCORE_THRESHOLD=3.0

# ── GATEWAY SERVICE (optional proxy) ────────────────────────
GATEWAY_PORT=8002
GATEWAY_OPENAI_BASE_URL=https://api.openai.com/v1
GATEWAY_ANTHROPIC_BASE_URL=https://api.anthropic.com
GATEWAY_GROQ_BASE_URL=https://api.groq.com/openai/v1
# When a cap is hit: block | alert_only
GATEWAY_CAP_ENFORCEMENT_MODE=alert_only

# ── DEMO / SEED ─────────────────────────────────────────────
# Tenant zero (Hiten Brahs Company)
SEED_TENANT_ID=00000000-0000-0000-0000-000000000001
SEED_USER_EMAIL=hiten@cirra.dev
SEED_USER_ID=00000000-0000-0000-0000-000000000002